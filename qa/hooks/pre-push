#!/bin/sh
# Arcana-paddhati QA vārti (qa/README.md) — palaižas pirms katra `git push`.
#   1) out/ vecāks par avotu → npm run build
#   2) python qa/lint_content.py      (satura likumi)
#   3) python qa/run_all.py --fast    (regresija: pixel7 + iphone14, ≤5 min)
# Jebkura kļūda → push BLOĶĒTS.
# Apiet: `git push --no-verify` — AIZLIEGTS bez Satkirti vai Gurudas tiešas ziņas (qa/README.md).
# Ieslēgt: npm run qa:install-hooks   (git config core.hooksPath qa/hooks)

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
mkdir -p qa/.results
PY=python
command -v python >/dev/null 2>&1 || PY=python3

HEAD_SHA=$(git rev-parse HEAD)
ZERO=0000000000000000000000000000000000000000
NEED=0
while read -r LREF LSHA RREF RSHA; do
  [ -z "$LREF" ] && continue
  [ "$LSHA" = "$ZERO" ] && continue            # ref deletion
  case "$RREF" in refs/tags/*) continue ;; esac  # tags (atgriešanās punkti) — bez testiem
  if [ "$LSHA" != "$HEAD_SHA" ]; then
    echo "QA BLOĶĒTS: push sūta $LREF ($LSHA), bet pārbaudīt var tikai izņemto HEAD ($HEAD_SHA)."
    echo "            Izņem to zaru (git checkout) un push no tā."
    exit 1
  fi
  NEED=1
done
[ "$NEED" = 1 ] || exit 0

# the gate tests the working tree: it must equal HEAD in everything that is built
DIRTY=$(git status --porcelain --untracked-files=no -- app components lib data public scripts package.json package-lock.json next.config.ts qa)
if [ -n "$DIRTY" ]; then
  echo "QA BLOĶĒTS: darba kokā ir necommitētas izmaiņas — tiktu testēts nevis tas, kas tiek sūtīts:"
  echo "$DIRTY" | sed 's/^/    /'
  echo "            Commit vai stash, tad push."
  exit 1
fi

T0=$(date +%s)
echo "== QA vārti: $(git log -1 --format='%h %s') =="
if $PY qa/lib/qa.py stale >/dev/null 2>&1; then
  echo "-- out/ vecāks par avotu → npm run build (log: qa/.results/build.log)"
  if ! npm run build >qa/.results/build.log 2>&1; then
    tail -30 qa/.results/build.log
    echo "QA BLOĶĒTS: npm run build krita (qa/.results/build.log)."
    exit 1
  fi
fi
echo "-- satura linteris"
if ! $PY qa/lint_content.py; then
  echo "QA BLOĶĒTS: satura linteris atrada Satkirti likuma pārkāpumu (augstāk FAIL rindas)."
  exit 1
fi
echo "-- regresija (ātrā)"
if ! $PY qa/run_all.py --fast --suites-skip lint; then
  echo "QA BLOĶĒTS: regresijas tests krita (augstāk FAIL; logi qa/.results/). Push NEnotika."
  exit 1
fi
echo "== QA vārti: viss izgāja ($(( $(date +%s) - T0 )) s) — push turpinās =="
exit 0
