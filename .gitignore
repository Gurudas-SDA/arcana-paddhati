# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated at build time (scripts/build-search-index.mjs)
/public/search-index.json
/public/search-index.*.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# windows
desktop.ini

# translation run artefacts
scripts/translate/progress.log
scripts/translate/cache/
scripts/translate/__pycache__/

# chapter sources: regenerable caches
scripts/chapters/*/calendar/out/
scripts/chapters/*/transcripts/
scripts/chapters/*/__pycache__/
scripts/chapters/__pycache__/

# transcript docx download cache (scripts/transcripts/build_transcripts.py)
/scripts/transcripts/cache/

# night sync log
scripts/translate/night_sync.log
