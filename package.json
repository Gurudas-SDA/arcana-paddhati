{
  "name": "arcana-paddhati",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-search-index.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-search-index.mjs",
    "build": "next build",
    "postbuild": "node scripts/patch-html-lang.mjs && node scripts/apply-base-path.mjs && node scripts/fix-segment-paths.mjs && node scripts/build-precache.mjs",
    "start": "next start",
    "lint": "eslint",
    "formats": "python scripts/formats/build_formats.py",
    "qa": "python qa/run_all.py",
    "qa:fast": "python qa/run_all.py --fast",
    "qa:lint": "python qa/lint_content.py",
    "qa:coverage": "python qa/coverage.py",
    "qa:install-hooks": "git config core.hooksPath qa/hooks"
  },
  "dependencies": {
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
